{
  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 100,
      "MaxConcurrentUpgradedConnections": 100
    },
    "EndPoints": {
      "Http2": {
        "Url": "https://[::]:5000",
        "Protocols": "Http2",
        "Certificate": {
          "Subject": "localhost",
          "Store": "My",
          "AllowInvalid": "true"
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Grpc": "Warning",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}