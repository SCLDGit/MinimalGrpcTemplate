{
  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 100,
      "MaxConcurrentUpgradedConnections": 100
    },
    "EndPoints": {
      "Http2": {
        "Url": "https://[::]:5000",
        "Protocols": "Http2",
        "Certificate": {
          "Subject": "localhost",
          "Store": "My",
          "AllowInvalid": "true"
        }
      }
    }
  },
  "Logging": {
    "Debug": {
      "IncludeScopes": false
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc.AspNetCore.Server": "Warning",
      "Microsoft.Extensions.Hosting": "Warning"
    }
  }
}